# =============================================================
# MindIsle（心屿）环境变量配置模板
#
# 使用方式：
#   1. 复制本文件为 .env   （Windows:  copy .env.example .env）
#   2. 填入你的大模型 API Key
#   3. 重启后端（uvicorn backend.app:app --reload 会自动加载 .env）
#
# 注意：.env 已被 .gitignore 忽略，API Key 不会提交到 Git。
# =============================================================

# 是否启用大模型自动回复（true=启用）。未配置 Key 或调用失败时会自动
# 回退到内置分级模板话术，不影响系统使用。
LLM_ENABLED=true

# API Key —— 从你选择的服务商控制台获取
LLM_API_KEY=sk-请换成你自己的密钥

# OpenAI 兼容服务地址（按需选择，保留一个即可）：
#   DeepSeek     https://api.deepseek.com/v1
#   OpenAI       https://api.openai.com/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   Moonshot     https://api.moonshot.cn/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama  http://localhost:11434/v1
LLM_API_BASE=https://api.deepseek.com/v1

# 模型名（与所选服务商保持一致）：
#   DeepSeek deepseek-chat | OpenAI gpt-4o-mini | 硅基流动 Qwen/Qwen2.5-7B-Instruct
#   Moonshot moonshot-v1-8k | 通义 qwen-plus | 智谱 glm-4-flash | Ollama qwen2
LLM_MODEL=deepseek-chat

# 请求超时（秒）
LLM_TIMEOUT=30
